# Database Connection (PostgreSQL - compatible with Neon, Supabase, AWS RDS, Local PostgreSQL)
DATABASE_URL="postgresql://username:password@ep-sample-pool.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Secret for Session Authentication
AUTH_SECRET="replace-with-a-secure-random-32-byte-secret"

# Public App URL for production or local development
NEXT_PUBLIC_APP_URL="http://localhost:3000"
